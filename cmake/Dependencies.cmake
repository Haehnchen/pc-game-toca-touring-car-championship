include_guard(GLOBAL)

set(TOCA_DEPENDENCY_CACHE "${CMAKE_SOURCE_DIR}/build/dependencies" CACHE PATH "Shared verified dependency archives and sources")
option(TOCA_USE_SYSTEM_SDL3 "Prefer an installed SDL3 matching the lock" ON)
option(TOCA_USE_SYSTEM_GLM "Prefer an installed GLM matching the lock" ON)
option(TOCA_BUILD_SHADERCROSS "Build the locked host shadercross instead of finding an installed CLI" OFF)
set(TOCA_SHADERCROSS_REVISION "" CACHE STRING "Revision assertion for a packaged shadercross without adjacent Git metadata")
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json" _toca_dependency_lock)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json")
string(JSON _toca_lock_schema GET "${_toca_dependency_lock}" schema_version)
if(NOT _toca_lock_schema EQUAL 1)
  message(FATAL_ERROR "Unsupported dependency lock schema: ${_toca_lock_schema}")
endif()

# Only verified archives and complete source trees are visible to another build.
function(toca_file_crc32 path output)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/checksum.py" "${path}"
    RESULT_VARIABLE checksum_result OUTPUT_VARIABLE checksum ERROR_VARIABLE checksum_error
    OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 120)
  if(NOT checksum_result STREQUAL "0")
    message(FATAL_ERROR "CRC32 failed for ${path}: ${checksum_error}")
  endif()
  set(${output} "${checksum}" PARENT_SCOPE)
endfunction()

function(toca_dependency_source name output)
  foreach(field IN ITEMS url archive root crc32)
    string(JSON ${field} GET "${_toca_dependency_lock}" archives "${name}" "${field}")
  endforeach()
  if(NOT url MATCHES "^https://")
    message(FATAL_ERROR "Dependency ${name} must use HTTPS")
  endif()
  file(MAKE_DIRECTORY "${TOCA_DEPENDENCY_CACHE}/archives" "${TOCA_DEPENDENCY_CACHE}/sources")
  file(LOCK "${TOCA_DEPENDENCY_CACHE}/cache.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
  if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Dependency cache lock failed after 120 seconds: ${lock_result}")
  endif()
  set(download "${TOCA_DEPENDENCY_CACHE}/archives/${archive}")
  if(EXISTS "${download}")
    toca_file_crc32("${download}" actual_checksum)
    if(NOT actual_checksum STREQUAL crc32)
      message(FATAL_ERROR "Cached dependency ${download} has CRC32 ${actual_checksum}; expected ${crc32}. Remove this corrupt archive and configure again.")
    endif()
  else()
    message(STATUS "Downloading locked dependency ${name}")
    file(DOWNLOAD "${url}" "${download}.part" TLS_VERIFY ON STATUS download_status TIMEOUT 120 INACTIVITY_TIMEOUT 30)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
      file(REMOVE "${download}.part")
      message(FATAL_ERROR "Dependency ${name} download failed: ${download_status}")
    endif()
    toca_file_crc32("${download}.part" actual_checksum)
    if(NOT actual_checksum STREQUAL crc32)
      file(REMOVE "${download}.part")
      message(FATAL_ERROR "Dependency ${name} CRC32 mismatch: ${actual_checksum}; expected ${crc32}")
    endif()
    file(RENAME "${download}.part" "${download}")
  endif()

  set(source "${TOCA_DEPENDENCY_CACHE}/sources/${name}-${crc32}")
  set(marker "${source}/.toca-extracted")
  set(complete FALSE)
  if(EXISTS "${marker}")
    file(READ "${marker}" marker_checksum)
    if(marker_checksum STREQUAL crc32 AND IS_DIRECTORY "${source}/${root}")
      set(complete TRUE)
    endif()
  endif()
  if(NOT complete)
    set(staging "${source}.extracting")
    file(REMOVE_RECURSE "${staging}")
    file(MAKE_DIRECTORY "${staging}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${download}"
      WORKING_DIRECTORY "${staging}" RESULT_VARIABLE extract_result ERROR_VARIABLE extract_error TIMEOUT 120)
    if(NOT extract_result STREQUAL "0" OR NOT IS_DIRECTORY "${staging}/${root}")
      file(REMOVE_RECURSE "${staging}")
      message(FATAL_ERROR "Extracting ${name} failed: ${extract_result}: ${extract_error}")
    endif()
    file(WRITE "${staging}/.toca-extracted" "${crc32}")
    file(REMOVE_RECURSE "${source}")
    file(RENAME "${staging}" "${source}")
  endif()
  set(${output} "${source}/${root}" PARENT_SCOPE)
endfunction()

function(toca_validate_shadercross executable)
  if(NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
    message(FATAL_ERROR "TOCA_SHADERCROSS must name an existing host executable: ${executable}")
  endif()
  string(JSON required_revision GET "${_toca_dependency_lock}" archives shadercross revision)
  set(revision "${TOCA_SHADERCROSS_REVISION}")
  get_filename_component(tool_directory "${executable}" DIRECTORY)
  find_package(Git QUIET)
  if(Git_FOUND)
    # The documented local installation is a build/ subdirectory of its checkout.
    foreach(directory IN ITEMS "${tool_directory}" "${tool_directory}/..")
      if(EXISTS "${directory}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" rev-parse HEAD
          OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE revision_result TIMEOUT 10)
        if(NOT revision_result EQUAL 0)
          message(FATAL_ERROR "Cannot determine installed shadercross source revision")
        endif()
        break()
      endif()
    endforeach()
  endif()
  if(NOT revision STREQUAL required_revision)
    message(FATAL_ERROR "shadercross must be revision ${required_revision}; detected '${revision}'. Set TOCA_SHADERCROSS to the matching CLI; for packaged tools without source metadata, set TOCA_SHADERCROSS_REVISION to its verified source revision.")
  endif()
  set(probe_directory "${CMAKE_BINARY_DIR}/CMakeFiles/toca-shadercross-probe")
  file(MAKE_DIRECTORY "${probe_directory}")
  file(WRITE "${probe_directory}/probe.hlsl" "float4 main(float4 position : TEXCOORD0) : SV_Position { return position; }\n")
  foreach(format IN ITEMS SPIRV DXIL MSL)
    execute_process(COMMAND "${executable}" "${probe_directory}/probe.hlsl" -s HLSL -d "${format}" -t vertex -e main -o "${probe_directory}/probe.${format}"
      RESULT_VARIABLE probe_result OUTPUT_VARIABLE probe_output ERROR_VARIABLE probe_error TIMEOUT 30)
    if(NOT probe_result STREQUAL "0")
      message(FATAL_ERROR "Installed shadercross ${format} capability check failed: ${probe_output}${probe_error}")
    endif()
  endforeach()
  message(STATUS "Validated installed shadercross revision ${revision} (SPIRV/DXIL/MSL)")
endfunction()

function(toca_setup_dependencies)
  string(JSON sdl_version GET "${_toca_dependency_lock}" archives sdl3 version)
  string(JSON glm_version GET "${_toca_dependency_lock}" archives glm version)
  if(TOCA_USE_SYSTEM_SDL3)
    find_package(SDL3 "${sdl_version}" EXACT CONFIG QUIET)
    if(DEFINED SDL3_DIR AND NOT SDL3_DIR MATCHES "-NOTFOUND$" AND NOT SDL3_FOUND)
      message(FATAL_ERROR "SDL3_DIR must provide locked SDL3 ${sdl_version}")
    endif()
  endif()
  if(NOT TARGET SDL3::SDL3)
    toca_dependency_source(sdl3 sdl_source)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
    set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
    set(SDL_INSTALL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_UNINSTALL OFF CACHE BOOL "" FORCE)
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
    add_subdirectory("${sdl_source}" "${CMAKE_BINARY_DIR}/dependencies/sdl3" EXCLUDE_FROM_ALL)
  endif()
  if(TOCA_USE_SYSTEM_GLM)
    find_package(glm "${glm_version}" EXACT CONFIG QUIET)
    if(DEFINED glm_DIR AND NOT glm_DIR MATCHES "-NOTFOUND$" AND NOT glm_FOUND)
      message(FATAL_ERROR "glm_DIR must provide locked GLM ${glm_version}")
    endif()
  endif()
  if(NOT TARGET glm::glm-header-only)
    toca_dependency_source(glm glm_source)
    set(GLM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(GLM_BUILD_LIBRARY OFF CACHE BOOL "" FORCE)
    set(GLM_BUILD_INSTALL OFF CACHE BOOL "" FORCE)
    block(SCOPE_FOR VARIABLES)
      # GLM 1.0.1 explicitly resets policies to 3.6. CMake 4 supports a
      # third-party policy floor; keep it local to GLM and retain stricter floors.
      if(NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM OR CMAKE_POLICY_VERSION_MINIMUM VERSION_LESS 3.10)
        set(CMAKE_POLICY_VERSION_MINIMUM 3.10)
      endif()
      add_subdirectory("${glm_source}" "${CMAKE_BINARY_DIR}/dependencies/glm" EXCLUDE_FROM_ALL)
    endblock()
  endif()

  if(NOT TOCA_BUILD_SHADERCROSS)
    find_program(TOCA_SHADERCROSS NAMES shadercross
      HINTS "$ENV{XDG_CACHE_HOME}/toca-tools/SDL_shadercross/build" "$ENV{HOME}/.cache/toca-tools/SDL_shadercross/build"
      DOC "Host shadercross CLI at the locked source revision")
  endif()
  if(TOCA_SHADERCROSS AND NOT TOCA_BUILD_SHADERCROSS)
    toca_validate_shadercross("${TOCA_SHADERCROSS}")
    set(TOCA_SHADERCROSS "${TOCA_SHADERCROSS}" PARENT_SCOPE)
    set(TOCA_SHADERCROSS_DEPENDENCY "${TOCA_SHADERCROSS}" PARENT_SCOPE)
    return()
  endif()
  if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Cross-compiling requires a host TOCA_SHADERCROSS executable at the locked revision")
  endif()
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(dxc_archive dxc-linux-x64)
  elseif(CMAKE_HOST_WIN32)
    set(dxc_archive dxc-windows)
  else()
    message(FATAL_ERROR "No locked DXC host archive for ${CMAKE_HOST_SYSTEM_NAME}/${CMAKE_HOST_SYSTEM_PROCESSOR}; provide TOCA_SHADERCROSS at the locked revision")
  endif()
  enable_language(C)
  toca_dependency_source(shadercross shadercross_source)
  toca_dependency_source(spirv-cross spirv_source)
  toca_dependency_source("${dxc_archive}" dxc_source)
  set(SPIRV_CROSS_CLI OFF CACHE BOOL "" FORCE)
  set(SPIRV_CROSS_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
  set(SPIRV_CROSS_SHARED ON CACHE BOOL "" FORCE)
  set(SPIRV_CROSS_STATIC OFF CACHE BOOL "" FORCE)
  set(SPIRV_CROSS_SKIP_INSTALL ON CACHE BOOL "" FORCE)
  add_subdirectory("${spirv_source}" "${CMAKE_BINARY_DIR}/dependencies/spirv-cross" EXCLUDE_FROM_ALL)
  # shadercross emits a build-tree export even with installation disabled.
  export(TARGETS spirv-cross-c-shared FILE "${CMAKE_BINARY_DIR}/dependencies/spirv-cross/toca-targets.cmake")
  # shadercross tests the package's underscored name, then links the hyphenated target.
  add_library(spirv_cross_c_shared ALIAS spirv-cross-c-shared)
  set(SDLSHADERCROSS_TESTS OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_INSTALL OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_INSTALL_RUNTIME OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_SHARED ON CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_STATIC OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_VENDORED OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_WERROR OFF CACHE BOOL "" FORCE)
  set(SDLSHADERCROSS_CLI ON CACHE BOOL "" FORCE)
  list(PREPEND CMAKE_MODULE_PATH "${shadercross_source}/cmake")
  set(DirectXShaderCompiler_ROOT "${dxc_source}")
  include("${shadercross_source}/cmake/sdlcpu.cmake")
  SDL_DetectTargetCPUArchitectures(SDL_CPU_NAMES)
  find_package(DirectXShaderCompiler REQUIRED)
  # The upstream project resets ROOT; the validated imported targets/cache values persist.
  add_subdirectory("${shadercross_source}" "${CMAKE_BINARY_DIR}/dependencies/shadercross" EXCLUDE_FROM_ALL)
  if(WIN32)
    set(runtime_marker "${CMAKE_BINARY_DIR}/dependencies/shadercross/runtime-$<CONFIG>.stamp")
    add_custom_command(OUTPUT "${runtime_marker}"
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_RUNTIME_DLLS:shadercross>" "$<TARGET_FILE_DIR:shadercross>"
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:DirectXShaderCompiler::dxil>" "$<TARGET_FILE_DIR:shadercross>"
      COMMAND "${CMAKE_COMMAND}" -E touch "${runtime_marker}"
      DEPENDS shadercross DirectXShaderCompiler::dxil
      COMMAND_EXPAND_LISTS VERBATIM)
    set(TOCA_SHADERCROSS_DEPENDENCY "${runtime_marker}" PARENT_SCOPE)
  else()
    set(TOCA_SHADERCROSS_DEPENDENCY shadercross PARENT_SCOPE)
  endif()
  set(TOCA_SHADERCROSS "$<TARGET_FILE:shadercross>" PARENT_SCOPE)
endfunction()
