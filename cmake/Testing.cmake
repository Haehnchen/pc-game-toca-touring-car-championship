include_guard(GLOBAL)
include(CMakeParseArguments)
if(NOT Python3_Interpreter_FOUND)
  find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
endif()

# Derive focused-build targets from the same declarations CTest uses.
set_property(GLOBAL PROPERTY TOCA_TEST_TARGETS "{}")
function(toca_write_test_targets)
  get_property(targets GLOBAL PROPERTY TOCA_TEST_TARGETS)
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/test-targets.json" CONTENT "${targets}\n")
endfunction()
cmake_language(DEFER CALL toca_write_test_targets)

function(toca_record_test_target name targets)
  get_property(mapping GLOBAL PROPERTY TOCA_TEST_TARGETS)
  string(JSON mapping SET "${mapping}" "${name}" "${targets}")
  set_property(GLOBAL PROPERTY TOCA_TEST_TARGETS "${mapping}")
endfunction()

# SOURCE creates a module test target; omit it to register another case of that target.
function(toca_add_test)
  cmake_parse_arguments(PARSE_ARGV 0 test "DISPLAY" "TARGET;NAME;SOURCE;TIMEOUT"
    "LIBRARIES;LABELS;ARGS;ENVIRONMENT")
  if(test_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "toca_add_test: unknown arguments: ${test_UNPARSED_ARGUMENTS}")
  endif()
  if(test_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "toca_add_test: missing values for: ${test_KEYWORDS_MISSING_VALUES}")
  endif()
  foreach(required IN ITEMS TARGET NAME)
    if(NOT test_${required})
      message(FATAL_ERROR "toca_add_test: ${required} is required")
    endif()
  endforeach()
  if(NOT DEFINED test_TIMEOUT)
    set(test_TIMEOUT 30)
  endif()
  if(NOT test_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "toca_add_test: TIMEOUT must be a positive integer")
  endif()
  if(test_SOURCE)
    if(NOT IS_ABSOLUTE "${test_SOURCE}")
      set(test_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/${test_SOURCE}")
    endif()
    if(NOT EXISTS "${test_SOURCE}")
      message(FATAL_ERROR "toca_add_test: SOURCE does not exist: ${test_SOURCE}")
    endif()
    if(TARGET "${test_TARGET}")
      message(FATAL_ERROR "toca_add_test: TARGET ${test_TARGET} already exists; omit SOURCE to reuse it")
    endif()
    if(test_SOURCE MATCHES "\\.py$")
      if(test_LIBRARIES)
        message(FATAL_ERROR "toca_add_test: Python tests cannot link LIBRARIES")
      endif()
      add_custom_target("${test_TARGET}" SOURCES "${test_SOURCE}")
      set_property(TARGET "${test_TARGET}" PROPERTY TOCA_PYTHON_TEST_SOURCE "${test_SOURCE}")
    else()
      add_executable("${test_TARGET}" "${test_SOURCE}")
      target_link_libraries("${test_TARGET}" PRIVATE toca-project-options ${test_LIBRARIES})
    endif()
  elseif(NOT TARGET "${test_TARGET}")
    message(FATAL_ERROR "toca_add_test: SOURCE is required for new TARGET ${test_TARGET}")
  elseif(test_LIBRARIES)
    message(FATAL_ERROR "toca_add_test: LIBRARIES requires SOURCE")
  endif()
  get_property(python_source TARGET "${test_TARGET}" PROPERTY TOCA_PYTHON_TEST_SOURCE)
  if(python_source AND DEFINED original_data_directory AND NOT "${original_data_directory}" STREQUAL "")
    list(FIND test_ENVIRONMENT "TOCA_DATA_ROOT=${original_data_directory}" bundled_environment_index)
    if(bundled_environment_index EQUAL -1)
      list(APPEND test_ENVIRONMENT "TOCA_DATA_ROOT=${original_data_directory}")
    endif()
  endif()
  if(DEFINED original_data_directory AND NOT "${original_data_directory}" STREQUAL "")
    list(FIND test_ARGS "${original_data_directory}" bundled_data_index)
    list(FIND test_ENVIRONMENT "TOCA_DATA_ROOT=${original_data_directory}" bundled_environment_index)
    if(NOT bundled_data_index EQUAL -1 OR NOT bundled_environment_index EQUAL -1)
      add_dependencies("${test_TARGET}" toca-original-data)
    endif()
  endif()
  if(DEFINED bundled_runtime_data AND NOT "${bundled_runtime_data}" STREQUAL "")
    list(FIND test_ARGS "${bundled_runtime_data}" bundled_runtime_index)
    if(NOT bundled_runtime_index EQUAL -1)
      add_dependencies("${test_TARGET}" toca-game-data-resources toca-audio-resources)
    endif()
  endif()
  if(python_source)
    set(command "${Python3_EXECUTABLE}" "${python_source}")
  else()
    set(command "$<TARGET_FILE:${test_TARGET}>")
  endif()
  set(runtime_args --name "${test_NAME}" --artifacts "${PROJECT_SOURCE_DIR}/build/test-artifacts"
    --timeout "${test_TIMEOUT}")
  foreach(entry IN LISTS test_ENVIRONMENT)
    if(NOT entry MATCHES "^[A-Za-z_][A-Za-z0-9_]*=")
      message(FATAL_ERROR "toca_add_test: ENVIRONMENT entries must have NAME=VALUE form: ${entry}")
    endif()
    list(APPEND runtime_args --env "${entry}")
  endforeach()
  if(test_DISPLAY)
    list(APPEND runtime_args --display)
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_test(NAME "${test_NAME}" COMMAND "${Python3_EXECUTABLE}"
      "${PROJECT_SOURCE_DIR}/tools/run-isolated.py" ${runtime_args} -- ${command} ${test_ARGS})
  else()
    set(private_work "${CMAKE_CURRENT_BINARY_DIR}/test-artifacts/${test_NAME}/work")
    file(MAKE_DIRECTORY "${private_work}")
    add_test(NAME "${test_NAME}" COMMAND "${CMAKE_COMMAND}" -E env
      "ASAN_OPTIONS=detect_leaks=1" "UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1"
      "SDL_AUDIODRIVER=dummy"
      ${test_ENVIRONMENT} ${command} ${test_ARGS})
    set_tests_properties("${test_NAME}" PROPERTIES WORKING_DIRECTORY "${private_work}")
  endif()
  # Ten seconds for X startup and four for TERM/KILL cleanup, with scheduling margin.
  math(EXPR ctest_timeout "${test_TIMEOUT} + 20")
  set_tests_properties("${test_NAME}" PROPERTIES LABELS "${test_LABELS}" TIMEOUT "${ctest_timeout}")
  if(test_DISPLAY)
    # Software rendering owns worker threads as well as the test process.
    # Account for that within the shared job budget; later case overrides win.
    set_tests_properties("${test_NAME}" PROPERTIES PROCESSORS 2)
  endif()
  toca_record_test_target("${test_NAME}" "[\"${test_TARGET}\"]")
endfunction()

function(toca_register_tests)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/FoundationVehicles.cmake")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/SimulationScene.cmake")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/RenderIntegration.cmake")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/ToolingReference.cmake")
endfunction()
