include_guard(GLOBAL)

if(NOT TOCA_DISTRIBUTION)
  return()
endif()

if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  message(FATAL_ERROR "TOCA_DISTRIBUTION requires CMAKE_BUILD_TYPE=Release")
endif()
if(BUILD_TESTING OR TOCA_SANITIZERS OR TOCA_USE_SYSTEM_SDL3)
  message(FATAL_ERROR "TOCA_DISTRIBUTION requires BUILD_TESTING=OFF, TOCA_SANITIZERS=OFF and TOCA_USE_SYSTEM_SDL3=OFF")
endif()

# Keep development builds unchanged. Distribution binaries must never resolve
# their shared libraries through an absolute build-tree RPATH.
get_target_property(package_sdl_target SDL3::SDL3 ALIASED_TARGET)
if(NOT package_sdl_target)
  set(package_sdl_target SDL3::SDL3)
endif()
if(UNIX AND NOT APPLE)
  set_target_properties(toca-game PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN/lib")
  set_target_properties(${package_sdl_target} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN")
elseif(APPLE)
  set_target_properties(toca-game PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "@executable_path/lib")
  set_target_properties(${package_sdl_target} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "@loader_path")
  target_link_options(toca-game PRIVATE "LINKER:-headerpad_max_install_names")
endif()

function(toca_package_json_string output value)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  string(REPLACE "\r" "\\r" escaped "${escaped}")
  string(REPLACE "\t" "\\t" escaped "${escaped}")
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

set(package_metadata "{}")
string(JSON package_metadata SET "${package_metadata}" schema_version 1)
foreach(field IN ITEMS executable asset_directory shader_directory audio_directory original_data_directory
    source_directory strip objdump system processor configuration)
  if(field STREQUAL "executable")
    set(value "$<TARGET_FILE:toca-game>")
  elseif(field STREQUAL "asset_directory")
    set(value "$<TARGET_FILE_DIR:toca-game>/assets")
  elseif(field STREQUAL "shader_directory")
    set(value "${shader_dir}")
  elseif(field STREQUAL "audio_directory")
    set(value "${package_audio_directory}")
  elseif(field STREQUAL "original_data_directory")
    set(value "${original_data_directory}")
  elseif(field STREQUAL "source_directory")
    set(value "${PROJECT_SOURCE_DIR}")
  elseif(field STREQUAL "strip")
    set(value "${CMAKE_STRIP}")
  elseif(field STREQUAL "objdump")
    set(value "${CMAKE_OBJDUMP}")
  elseif(field STREQUAL "system")
    set(value "${CMAKE_SYSTEM_NAME}")
  elseif(field STREQUAL "processor")
    set(value "${CMAKE_SYSTEM_PROCESSOR}")
  else()
    set(value "$<CONFIG>")
  endif()
  toca_package_json_string(value_json "${value}")
  string(JSON package_metadata SET "${package_metadata}" "${field}" "${value_json}")
endforeach()
set(package_library_directories "$<TARGET_FILE_DIR:SDL3::SDL3>")
if(MINGW)
  foreach(runtime IN ITEMS libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${runtime}"
      OUTPUT_VARIABLE runtime_file OUTPUT_STRIP_TRAILING_WHITESPACE
      RESULT_VARIABLE runtime_result TIMEOUT 10)
    if(runtime_result EQUAL 0 AND EXISTS "${runtime_file}")
      get_filename_component(runtime_directory "${runtime_file}" DIRECTORY)
      list(APPEND package_library_directories "${runtime_directory}")
    endif()
  endforeach()
endif()
list(REMOVE_DUPLICATES package_library_directories)
set(package_library_directories_json "[]")
foreach(directory IN LISTS package_library_directories)
  string(JSON directory_index LENGTH "${package_library_directories_json}")
  toca_package_json_string(directory_json "${directory}")
  string(JSON package_library_directories_json SET "${package_library_directories_json}" ${directory_index} "${directory_json}")
endforeach()
string(JSON package_metadata SET "${package_metadata}" library_directories "${package_library_directories_json}")
set(package_shader_files "[]")
foreach(shader IN LISTS compiled_shaders)
  string(JSON shader_index LENGTH "${package_shader_files}")
  toca_package_json_string(shader_json "${shader}")
  string(JSON package_shader_files SET "${package_shader_files}" ${shader_index} "${shader_json}")
endforeach()
string(JSON package_metadata SET "${package_metadata}" shader_files "${package_shader_files}")

# Multi-config generators also expose one stable metadata path for Release.
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/toca-package.json"
  CONTENT "${package_metadata}\n" CONDITION "$<CONFIG:Release>")
