include_guard(GLOBAL)

set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
option(TOCA_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer for project code" OFF)

add_library(toca-project-options INTERFACE)
target_compile_features(toca-project-options INTERFACE cxx_std_23)
if(WIN32)
  target_compile_definitions(toca-project-options INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
if(MSVC)
  target_compile_options(toca-project-options INTERFACE /W4 /WX /permissive- /Zc:__cplusplus)
else()
  target_compile_options(toca-project-options INTERFACE -Wall -Wextra -Wpedantic -Werror)
endif()

if(TOCA_SANITIZERS)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$" OR MSVC)
    message(FATAL_ERROR "TOCA_SANITIZERS requires GCC or Clang with AddressSanitizer and UndefinedBehaviorSanitizer support")
  endif()
  target_compile_options(toca-project-options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
  target_link_options(toca-project-options INTERFACE -fsanitize=address,undefined)
endif()
